# Copy this file to .env and fill in your key:
#     cp .env.example .env
#
# .env is in .gitignore, so it never gets committed.

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Optional settings (the defaults are fine to start) ----

# Which microphone to use. Leave it out for the system default, or set it to
# part of a device name or a device number.
# See the list with:  python src/audio_in.py --devices
#
# Check this one if recording comes back silent: if you have BlackHole,
# Loopback, or a virtual meeting device installed, macOS may be defaulting
# to it, and those record what the computer plays, not what you say.
# INPUT_DEVICE=MacBook Air Microphone

# Which Claude model to use.
# Sonnet by default — it answers a spoken question about twice as fast as
# Opus and just as well. claude-haiku-4-5-20251001 is faster still.
# CLAUDE_MODEL=claude-sonnet-5

# Let Claude search the web when a question turns on something recent — the
# news, a score, when a shop shuts. The search runs on Anthropic's side, so
# it costs the Pi nothing, but it costs money per search and adds two or
# three seconds to those answers. Everything else answers at normal speed.
# WEB_SEARCH=off
# WEB_SEARCH_MAX=3

# Roughly where the speaker is, said the way you'd say it out loud. The time
# zone is detected automatically; a town also makes "how long until it gets
# dark" answerable. Leave it out if you'd rather not.
# LOCATION=Palo Alto, California

# Who it's talking to, so it sounds less like a stranger.
# HOUSEHOLD=Tejas and his family

# Which macOS voice to speak with. See all of them with: say -v '?'
# VOICE=Samantha

# Which voice to speak with on Linux — this is the one the Raspberry Pi
# uses. Listen to them at https://rhasspy.github.io/piper-samples/
# Keep to a "medium" voice on a Pi 4; "high" is slower than talking.
# PIPER_VOICE=en_GB-alan-medium

# How loud, as a percentage. USB speakers often arrive turned well down,
# so the speaker sets this at startup. Leave it blank to not touch the
# system mixer at all.
# OUTPUT_VOLUME=100

# Which speaker to play out of. Empty means the system default, which on a
# Pi is often an HDMI port with nothing plugged into it.
# See the list with:  python src/tts.py --devices
# OUTPUT_DEVICE=Headphones

# How fast to talk, in words per minute.
# SPEECH_RATE=180

# Whisper model size: tiny.en is fastest, base.en is a good balance,
# small.en is more accurate but slower.
# WHISPER_MODEL=base.en

# Wake word backend: auto | openwakeword | key
#   auto         - use openwakeword if it's installed, otherwise push-to-talk
#   openwakeword - always use the wake word
#   key          - always use push-to-talk (press Enter to talk)
# WAKE_MODE=auto

# Which wake word model to listen for. openWakeWord ships with a few
# pre-trained ones: hey_jarvis, alexa, hey_mycroft.
# There is no pre-trained "Hey Claude" yet — see docs/design.md.
# WAKE_MODEL=hey_jarvis

# How long a finished timer keeps ringing if nobody says anything. It beeps
# in bursts with gaps to listen in, so "hey claude" stops it early.
# RING_SECONDS=30

# The LED ring on the microphone array: blue for listening, green for
# talking, red when a timer goes off. Brightness is out of 255 — the ring is
# genuinely bright, and this is a lamp on a shelf, not a server room.
# LEDS=off
# LED_BRIGHTNESS=40

# The gap between sentences on the Pi, in seconds. Piper's own works out at
# about a fifth of a second, which sounds slow read aloud.
# SENTENCE_PAUSE=0.12

# Background sounds — rain, ocean, fireplace, fan, white/pink/brown noise.
# Volume is 0 to 1, and quiet on purpose: this is something to fall asleep
# to, and the microphone has to hear you over it.
# SOUND_VOLUME=0.30
# SOUND_HOURS=8

# Write down every wake-word firing and how the turn went, so the mistakes
# can be learned from. See train/label_wakes.py and train/relearn.py.
# WAKE_LOG=off
# WAKE_LOG_CLIPS=400

# A key for Freesound, which is much the better place to look up a
# recording of a bullfrog. Free from https://freesound.org/apiv2/apply/.
# Without one it falls back to Wikimedia Commons, which needs no account.
# FREESOUND_API_KEY=

# Spotify. Needs Premium — librespot cannot stream on a free account.
# Make a free app at https://developer.spotify.com/dashboard with redirect
# URI http://127.0.0.1:8888/callback, then run train/spotify_login.py once.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_DEVICE=Claude Speaker

# A Hugging Face token, so each retraining commits the data it used and
# stamps the model with that commit. Without one, retraining still works
# and nothing is archived. Use a fine-grained token with write access to
# the one dataset repository — this sits on a device in a living room.
# HF_TOKEN=

# How much firing on the room a new wake-word model may do, as a fraction
# of the mistakes a person has labelled. The retraining sweeps thresholds
# and takes the one that catches most within this. The one number in the
# project that is a judgement rather than a measurement: how much
# television is worth how much of a child being heard.
# WAKE_FALSE_BUDGET=0.15

# A page served from the Pi for a browser on the same network: what the
# speaker is doing, how the machine is, and which Wi-Fi it is on. It has no
# password — anybody who can reach the Pi can see what was asked and change
# the network — so it belongs on a home network and nowhere else.
# DASHBOARD=off
# DASHBOARD_PORT=8080
